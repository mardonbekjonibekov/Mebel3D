# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads & local db
/uploads
/prisma/dev.db
/prisma/dev.db-journal
/.tools

# keep the template, ignore real secrets
!.env.example

# local database and user uploads (runtime data, not source)
/prisma/dev.db
/prisma/dev.db-journal
/uploads/

# local tooling / editor
/.tools/
/.claude/
__pycache__/
